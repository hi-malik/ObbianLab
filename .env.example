DATABASE_URL=postgres://obbian:obbian@localhost:5432/obbian
REDIS_URL=redis://localhost:6379/0
KAFKA_BROKERS=localhost:19092
AI_DEMO_TOKEN=replace-for-any-shared-environment
INTERNAL_SERVICE_TOKEN=replace-for-any-shared-environment
SANDBOX_WEBHOOK_SECRET=replace-for-any-shared-environment
WS_DEMO_TOKEN=replace-for-any-shared-environment
AUTH_MODE=demo
# Optional: offline models with strict authentication for the free cloud demo.
# AI_PROVIDER_MODE=offline
AUTH_SIGNING_SECRET=local-development-only-secret-32-characters
# Optional. Without these, the deterministic offline intent model is used.
LLM_BASE_URL=https://api.openai.com
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

EMBEDDING_BASE_URL=https://api.openai.com
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ASR_BASE_URL=https://api.openai.com
ASR_API_KEY=
ASR_MODEL=whisper-1
# Only test credentials are accepted; sandbox remains an explicit local simulator.
PAYMENT_GATEWAY=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Strict mode prices are immutable once quoted for a booking.
# Example SERVICE_PRICES_JSON={"electrician":{"amountMinor":250000,"currency":"INR"},"plumber":{"amountMinor":200000,"currency":"INR"},"cleaner":{"amountMinor":100000,"currency":"INR"},"ride":{"amountMinor":15000,"currency":"INR"}}
SERVICE_PRICES_JSON=
STRIPE_CONNECT_DESTINATIONS={}
